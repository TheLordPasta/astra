generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  email             String?  @db.VarChar(255)
  phone             String?  @db.VarChar(50)
  city              String?  @db.VarChar(100)
  instagramUsername String?  @db.VarChar(100)
  createdAt         DateTime @default(now())
  wishlistItems WishlistItem[]

  designers     Designer[]
  orders        Order[]
  conversations Conversation[]

  @@index([instagramUsername])
}

model Designer {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  brandName         String?  @db.VarChar(150)
  instagramUsername String?  @db.VarChar(100)
  country           String?  @db.VarChar(100)
  specialization    String?  @db.VarChar(150)
  customerId        Int?
  createdAt         DateTime @default(now())
  fabricReferences Fabric[] 
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([instagramUsername])
}


model Fabric {
  id               Int       @id @default(autoincrement())
  referenceName    String?   @db.VarChar(200)
  providerName     String?   @db.VarChar(150)

  fabricType       String?   @db.VarChar(100)
  composition      String?   @db.VarChar(255)
  color            String?   @db.VarChar(100)
  weightGrams      Int?
  stretch          Boolean   @default(false)
  transparency     String?   @db.VarChar(50)

  pricePerMeter    Decimal?  @db.Decimal(10, 2)
  stockMeters      Decimal?  @db.Decimal(10, 2)

  description      String?
  isActive         Boolean   @default(true)

  sourceDesignerId Int?
  sourceDesigner   Designer? @relation(fields: [sourceDesignerId], references: [id])

  images           FabricImage[]
  wishlistItems    WishlistItem[]

  createdAt        DateTime  @default(now())

  @@index([providerName])
  @@index([sourceDesignerId])
}

model FabricImage {
  id          Int      @id @default(autoincrement())
  fabricId    Int
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  fabric      Fabric   @relation(fields: [fabricId], references: [id])

  @@index([fabricId])
}

model Order {
  id          Int      @id @default(autoincrement())
  customerId  Int
  orderDate   DateTime @default(now())
  totalAmount Decimal  @db.Decimal(12, 2)
  status      String   @default("pending") @db.VarChar(50)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([orderDate])
}

model Conversation {
  id         Int      @id @default(autoincrement())
  customerId Int?
  platform   String?  @db.VarChar(50)
  startedAt  DateTime @default(now())
  status     String   @default("open") @db.VarChar(50)

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Competitor {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  website           String?  @db.VarChar(255)
  instagramUsername String?  @db.VarChar(100)
  notes             String?
  createdAt         DateTime @default(now())

  @@index([instagramUsername])
}

model Trend {
  id           Int                @id @default(autoincrement())
  name         String             @db.VarChar(150)
  category     String?            @db.VarChar(100)
  description  String?
  createdAt    DateTime           @default(now())

  observations TrendObservation[]
}

model TrendObservation {
  id          Int       @id @default(autoincrement())
  trendId     Int

  market      String?   @db.VarChar(100)
  segment     String?   @db.VarChar(100)
  garmentType String?   @db.VarChar(100)
  signal      String?   @db.VarChar(100)
  evidence    String?
  source      String?   @db.VarChar(500)

  observedAt  DateTime  @default(now())
  confidence  Float?

  trend       Trend     @relation(fields: [trendId], references: [id])

  @@index([trendId])
  @@index([market])
  @@index([segment])
  @@index([observedAt])
}

model Opportunity {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  type        String?  @db.VarChar(100)
  description String?
  priority    Int?
  status      String   @default("open") @db.VarChar(50)
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([priority])
}

model WishlistItem {
  id              Int       @id @default(autoincrement())
  customerId      Int
  fabricId        Int?
  description     String?
  requestedMeters Decimal?  @db.Decimal(10, 2)
  status          String    @default("active") @db.VarChar(50)
  notes           String?
  createdAt       DateTime  @default(now())

  customer        Customer  @relation(fields: [customerId], references: [id])
  fabric          Fabric?   @relation(fields: [fabricId], references: [id])

  @@index([customerId])
  @@index([status])
}